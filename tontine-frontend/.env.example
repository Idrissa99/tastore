# URL de base de l'API Laravel, sans barre oblique finale.
#
# LOCAL (développement) :
#   VITE_API_BASE_URL=http://127.0.0.1:8000/api
#
# DÉPLOIEMENT (Vercel → Settings → Environment Variables, pour Production,
# Preview ET Development) : l'URL publique HTTPS de l'API sur Render.
#   VITE_API_BASE_URL=https://tastore-api.onrender.com/api
#
# Cette variable est INCLUSE dans le bundle du navigateur : n'y mets jamais
# de secret. `src/config/api.js` échoue bruyamment au chargement si elle est
# absente d'un build de production, plutôt que de retomber sur localhost.
VITE_API_BASE_URL=https://tastore-api.onrender.com/api
