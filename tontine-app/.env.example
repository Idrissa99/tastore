# ---------------------------------------------------------------------------
# Tontine d'achat — configuration d'exemple
# ---------------------------------------------------------------------------
# Copiez ce fichier en .env puis renseignez les valeurs.
# AUCUN secret réel ne doit figurer ici. Les valeurs de ce fichier sont
# volontairement "de démonstration" : en production, le garde de démarrage
# refuse une configuration incomplète ou dangereuse.
# ---------------------------------------------------------------------------

APP_NAME="Tontine d'achat"
APP_ENV=local
APP_KEY=
# true en développement, OBLIGATOIREMENT false en production (les stack traces
# exposent l'arborescence, les variables d'environnement et la configuration).
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# 12 est le minimum raisonnable en production ; montez-le si le CPU le permet.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# SQLite : développement, démonstration, petit environnement contrôlé.
# Une seule instance backend, peu d'écritures concurrentes, sauvegardes
# régulières. Voir docs/PRODUCTION.md pour la migration vers un moteur serveur.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Conserve l'application des clés étrangères (par défaut true, on le pose
# explicitement car c'est une garantie d'intégrité du schéma).
DB_FOREIGN_KEYS=true

# --- Concurrence SQLite (Priorité 4 §2/§6) ---------------------------------
# Mesuré sur ce projet : sans DB_SQLITE_BUSY_TIMEOUT, deux requêtes qui
# tombent au même instant donnent « database is locked » en 0,00 s. Avec 5000,
# la seconde attend et aboutit (mesuré : succès après 1,58 s d'attente).
#   DB_SQLITE_BUSY_TIMEOUT : durée d'attente d'un verrou occupé, en ms.
#     0 = échouer immédiatement (défaut SQLite, source d'erreurs 500).
#     null = ne pas envoyer le PRAGMA, comportement historique.
#   DB_SQLITE_JOURNAL_MODE : WAL permet les lectures pendant une écriture.
#     En mode `delete` (défaut), afficher une page bloque les écritures.
#   DB_SQLITE_SYNCHRONOUS : NORMAL est le compromis recommandé par SQLite en
#     mode WAL. FULL si l'hébergeur coupe le courant sans prévenir.
# Ces trois réglages sont SANS EFFET sur MySQL/PostgreSQL.
# Sur un disque lent ou une base en lecture seule, remettez-les à null.
DB_SQLITE_BUSY_TIMEOUT=5000
DB_SQLITE_JOURNAL_MODE=WAL
DB_SQLITE_SYNCHRONOUS=NORMAL

# MySQL / MariaDB 8 — moteur recommandé avant production commerciale.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tontine
# DB_USERNAME=tontine
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=tontine
# DB_USERNAME=tontine
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cache / session / file d'attente
# ---------------------------------------------------------------------------
# IMPORTANT : sur une base serveur, NE laissez pas cache et session sur la
# même base que les données métier : chaque lecture de page écrit alors une
# ligne, ce qui multiplie les écritures et les contentions de verrou.
# Redis (ou Memcached) est le réglage adapté à plusieurs instances backend.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true en production (le cookie ne part alors qu'en HTTPS).
SESSION_SECURE_COOKIE=false
# 'lax' convient : la SPA et l'API sont sur des sites différents mais
# le même site (sous-domaines). 'none' exigerait Secure et n'apporterait rien ici.
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
# AUCUNE opération financière n'est mise en file : paiement, clôture de round,
# remboursement et livraison sont synchrones et transactionnels. Le fichier
# `jobs` ne sert qu'aux notifications et à d'éventuels travaux de maintenance.
# Un worker qui n'est jamais démarré fait donc grossir la table sans conséquence
# sur l'argent — mais il faut le lancer (voir docs/PRODUCTION.md §11).
# Délai avant qu'un job réservation soit considéré comme perdu (secondes).
# Doit rester > au --timeout du worker, sinon deux workers traitent le même job.
DB_QUEUE_RETRY_AFTER=90

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Proxies de confiance (Nginx, Apache, Cloudflare, load balancer).
# Jamais "*" sans justification : cela permettrait de forcer n'importe quelle IP
# et de contourner la détection HTTPS. Mettre la liste réelle des proxies,
# ou une plage CIDR de l'hébergeur. Voir docs/PRODUCTION.md.
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Redis (si utilisé pour cache / session / file d'attente)
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Journalisation
# ---------------------------------------------------------------------------
# "daily" est OBLIGATOIRE en production : le canal "single" écrit un seul
# fichier qui grossit sans limite et remplit le disque.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# "debug" en local, "info" ou "warning" en production.
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Sécurité applicative (Priorité 3)
# ---------------------------------------------------------------------------
# Durée de vie des tokens Sanctum, en MINUTES (43200 = 30 jours).
# 0 = pas d'expiration : développement local uniquement, JAMAIS en production.
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_NAME=spa
# Un changement de mot de passe invalide toutes les AUTRES sessions.
SESSION_REVOKE_OTHERS_ON_PASSWORD_CHANGE=true

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
# ORIGINE publique du SPA (pas l'URL de l'API). Doit être en HTTPS en prod.
FRONTEND_URL=http://localhost:5173
# Origines CORS supplémentaires, séparées par des virgules.
FRONTEND_URLS=
CORS_MAX_AGE=0
# Domaines Sanctum « stateful » (cookies). Inutile avec des tokens Bearer.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# ---------------------------------------------------------------------------
# Paiements
# ---------------------------------------------------------------------------
# TAUX DE COMMISSION FIGÉ : 0.07 = 7 %. Ne pas modifier : ce taux est
# historique et colonnes gelées par transaction dans la base.
COMMISSION_RATE=0.07
PAYMENT_CURRENCY=XOF

# AUCUN FOURNISSEUR MOBILE MONEY RÉEL N'EST INTÉGRÉ. "fake" est le seul
# gateway disponible et il refuse de s'exécuter en production
# (PAYMENT_ALLOW_FAKE_IN_PRODUCTION=false). L'intégration d'un opérateur réel
# fera l'objet d'une priorité dédiée.
PAYMENT_PROVIDER=fake
PAYMENT_ALLOW_FAKE_IN_PRODUCTION=false

# Secret partagé de signature des webhooks. OBLIGATOIRE et non prévisible en
# production : sans lui, tous les webhooks sont rejetés (503).
MOBILEMONEY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Sauvegardes (Priorité 4)
# ---------------------------------------------------------------------------
# Chemin RELATIF à la racine du projet. Doit rester hors de public/ et de
# storage/app/public (servi en HTTP). La commande refuse d'écrire ailleurs.
BACKUP_DIRECTORY=storage/app/backups
# Purge manuelle via `php artisan app:prune-backups` (jamais automatique).
BACKUP_RETAIN=14
BACKUP_RETAIN_DAYS=30

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Stockage objet (optionnel)
# ---------------------------------------------------------------------------
FILESYSTEM_CLOUD=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
